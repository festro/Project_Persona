# ── Models (user-provided, never committed) ──────────
models/*.gguf
models/*.bin
models/*.part
models/archive/

# ── Hermes kanban runtime state (H2 bridge) ──────────
run/hermes_kanban/
logs/wsl_h2_sim.log
persona/config.yaml.bak
tools/_mount_probe.txt

# ── Virtual environments ─────────────────────────────
env/
.venv/
venv/
env_webui/
env_hermes/

# ── Runtime state ────────────────────────────────────
# NOTE: run/config.toml AND run/config.<host>.toml (per-host overrides) are the
# COMMITTED source of truth -- do NOT add a broad run/*.toml ignore here.
run/*.pid
run/*.sock
run/*.env
!run/llama-servers.env
!run/llama-servers.windows.env
!run/llama-servers.linux.env
!run/config.env
run/node_capabilities.json
run/jobs/
run/jobs.jsonl
logs/
*.log

# ── Persistent application state ─────────────────────
data/
inbox/
/openwebui/   # OpenWebUI WEBUI_DATA_DIR (root only) -- anchored so tools/openwebui/ (the task Tool plugin) stays tracked
.webui_secret_key

# ── Vector store / memory artifacts ──────────────────
persona/**/chroma/
persona/**/chroma.sqlite3
persona/**/memory/chroma/
persona/global_memory/chroma/
persona/**/memory/exports/
persona/**/exports/
services/chromadb/

# ── Hermes-managed per-profile files ─────────────────
# (locked 2026-05-14 — Hermes writes/maintains these per profile;
#  template repo only ships empty SOUL.md and .hermes.md placeholders)
persona/profiles/*/MEMORY.md
persona/profiles/*/USER.md
persona/profiles/*/hermes_state.db
persona/profiles/*/sessions/

# ── Per-profile gate test fixtures (exit_gate_live.py creates these) ──
persona/profiles/alice/
persona/profiles/bob/

# ── Portable Windows runtime (PortableGit + extracted binaries) ─
portable/

# ── llama.cpp build artifacts ────────────────────────
llama_cpp/build/
llama_cpp/windows/
llama_cpp/**/*.o
llama_cpp/**/*.a
llama_cpp/**/*.so
llama_cpp/**/*.dll
llama_cpp/**/*.dylib
llama_cpp/**/*.exe

# ── Python noise ─────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── OS / editor noise ────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.tmp
.vscode/
.idea/

# ── Agent / job runtime artifacts ────────────────────
agent_*.json
job*.json
*_result.json
scan_result.json
# tools/ holds the taskman orchestration SCRIPTS required by /agent/run
# (taskman.py, taskman2.py) -- track the .py; ignore only json artifacts dropped
# here. (Job artifacts actually land in run/jobs/, already ignored above.)
tools/*.json

# ── Task Board SQLite store (default data/ already ignored; guard overrides) ─
tasks.db
tasks.db-wal
tasks.db-shm

# ── Local archive (stale files moved out of repo root) ─
# (sandbox couldn't rm directly; user can rm -rf archive/cruft/ when ready)
archive/cruft/

# ── Transient scp verification hashes ─────────────────
run/*.sha256*
