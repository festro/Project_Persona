# Unified single-model topology — Qwen3-30B-A3B-Instruct-2507 Q5_K_M
# Edited 2026-05-16 for qwen-test single-model migration
# (Prior: persona + scientist dual-server; see git log af0db13 for prior shape)

# Network
HOST=127.0.0.1

# Threading + batch sizing
THREADS=0
BATCH_SIZE=512
UBATCH_SIZE=512

# KV cache (q8_0 because this Vulkan build reports bf16=0)
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0

PERSONA_PORT=8080

# Unified server (keeps PERSONA_* names for pidfile/status.sh compat per minimal-scope decision)
PERSONA_MODEL=Qwen_Qwen3-30B-A3B-Instruct-2507-Q5_K_M.gguf
PERSONA_CTX=32768
GPU_LAYERS_PERSONA=999
PERSONA_PARALLEL=4

# Path for llama.cpp shared libs (informational; launcher hardcodes its own LD_LIBRARY_PATH)
LLAMA_LIB_DIR=$HOME/Git/Project_Persona/llama_cpp/build/bin
